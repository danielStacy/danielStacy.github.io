---
import '@fontsource/libre-caslon-text/400.css';
import '@fontsource/libre-caslon-text/400-italic.css';
import '@fontsource/libre-caslon-text/700.css';
import '@fontsource/playfair-display/800.css';
import '@fontsource-variable/ibm-plex-sans/wght.css';
import caslonRegular from '@fontsource/libre-caslon-text/files/libre-caslon-text-latin-400-normal.woff2?url';
import playfairBold from '@fontsource/playfair-display/files/playfair-display-latin-800-normal.woff2?url';
import '../styles/global.css';
import Masthead from '../components/Masthead.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface ShareImage {
	src: string;
	width: number;
	height: number;
	alt: string;
}

interface Props {
	title?: string;
	description?: string;
	/** The image in link previews, such as an article's cover. Defaults to the site card. */
	shareImage?: ShareImage;
	shareType?: 'website' | 'article';
}

const siteCard: ShareImage = {
	src: '/site-card.png',
	width: 1200,
	height: 630,
	alt: 'Daniel Stacy: data analysis on public Australian datasets',
};

const {
	title,
	description = 'Data analysis on public Australian datasets, by Daniel Stacy.',
	shareImage = siteCard,
	shareType = 'website',
} = Astro.props;
const pageTitle = title ? `${title} · Daniel Stacy` : 'Daniel Stacy';

// Link previews need absolute URLs.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(shareImage.src, Astro.site).href;
---

<html lang="en-AU">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="color-scheme" content="light dark" />
		{/* Applies a saved theme before first paint, so the other theme never flashes. */}
		<script is:inline>
			try {
				const theme = localStorage.getItem('theme');
				if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
			} catch {
				// Storage can be blocked; the system setting still applies.
			}
		</script>
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		{/* Body text and the wordmark are visible on first paint, so fetch them before the CSS asks. */}
		<link rel="preload" href={caslonRegular} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={playfairBold} as="font" type="font/woff2" crossorigin />
		<title>{pageTitle}</title>
		{/* Open Graph tags, which LinkedIn and most other sites read to build link previews. */}
		<meta property="og:type" content={shareType} />
		<meta property="og:site_name" content="Daniel Stacy" />
		<meta property="og:locale" content="en_AU" />
		<meta property="og:title" content={title ?? 'Daniel Stacy'} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:width" content={String(shareImage.width)} />
		<meta property="og:image:height" content={String(shareImage.height)} />
		<meta property="og:image:alt" content={shareImage.alt} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<a class="skip-link" href="#main">
			Skip to content
		</a>
		<Masthead />
		<main id="main">
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>

<style>
	/* Off-screen until focused, so keyboard users can jump past the masthead and nav. */
	.skip-link {
		position: absolute;
		top: 0.5rem;
		left: 0.5rem;
		z-index: 1;
		padding: 0.5rem 0.75rem;
		background: var(--ink);
		color: var(--paper);
		font-family: var(--sans);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		transform: translateY(-200%);
	}

	.skip-link:focus {
		transform: none;
	}

	main {
		max-width: var(--page-width);
		margin: 0 auto;
		padding-inline: var(--gutter);
	}
</style>
