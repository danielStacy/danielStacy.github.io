---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getImage, Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { tagLabels } from '../../content/tags';
import PageLayout from '../../layouts/PageLayout.astro';
import '../../styles/prose.css';
import { formatDate, isoDate } from '../../utils/formatDate';

export const getStaticPaths = (async () => {
	const articles = await getCollection('articles');
	return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { article } = Astro.props;
const { title, description, pubDate, cover, coverAlt } = article.data;
const { Content } = await render(article);

// Link previews show the cover cropped to 1200 × 630, the 1.91:1 shape LinkedIn uses, as a JPEG.
// Astro won't convert SVG, so an SVG cover (only the sample article's) leaves the site card instead.
const preview =
	cover.format === 'svg'
		? undefined
		: await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
---

<PageLayout
	as="article"
	title={title}
	kicker={tagLabels(article.data.tags)}
	intro={description}
	shareImage={preview && { src: preview.src, width: 1200, height: 630, alt: coverAlt }}
>
	<p class="meta" slot="meta">
		<time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
	</p>
	<figure class="cover">
		{/* Above the fold, so it loads straight away rather than lazily. */}
		<Image
			src={cover}
			alt={coverAlt}
			widths={[640, 960, 1280, 1536]}
			sizes="(min-width: 48rem) 48rem, 100vw"
			loading="eager"
			fetchpriority="high"
		/>
	</figure>
	<div class="prose">
		<Content />
	</div>
</PageLayout>

<style>
	/* Wider than the text, so charts get room while lines stay a comfortable length. */
	.cover {
		max-width: 48rem;
		margin: 0 auto 2.5rem;
	}

	.cover :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
