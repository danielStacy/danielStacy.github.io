---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { tagLabels } from '../content/tags';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, isoDate } from '../utils/formatDate';

const [featured, ...others] = (await getCollection('articles')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Fill the recent row until there are enough real articles. Delete these once there are four.
const placeholders = [
	{
		title: 'What the Labour Force survey can and can’t tell you',
		description:
			'Seasonal adjustment, trend series and sample error, explained with one month of data.',
	},
	{
		title: 'Mapping a century of fire weather',
		description:
			'Using Bureau of Meteorology station data to see how fire danger seasons have lengthened.',
	},
	{
		title: 'Commute times across the capital cities',
		description: 'Where the longest trips are, and why averages flatter the outer suburbs.',
	},
];

const recent = others.slice(0, 3);
const fillers = placeholders.slice(0, 3 - recent.length);
---

<BaseLayout>
	<section class="about">
		<p>
			I’m a data analyst who writes about public datasets: what they say, what they leave out, and
			how to read them carefully.
		</p>
		<a class="meta" href="/about/">
			More about me →
		</a>
	</section>

	{featured && (
		<article class="featured">
			{/* Above the fold, so it loads straight away rather than lazily. */}
			<Image
				class="featured__cover"
				src={featured.data.cover}
				alt={featured.data.coverAlt}
				widths={[640, 960, 1280]}
				sizes="(min-width: 72rem) 42rem, (min-width: 48rem) 58vw, 100vw"
				loading="eager"
				fetchpriority="high"
			/>
			<div class="featured__text">
				<p class="kicker kicker--accent">Featured · {tagLabels(featured.data.tags)}</p>
				<h1>
					<a href={`/articles/${featured.id}/`}>{featured.data.title}</a>
				</h1>
				<p class="featured__description">{featured.data.description}</p>
				<p class="meta">
					<time datetime={isoDate(featured.data.pubDate)}>{formatDate(featured.data.pubDate)}</time>
				</p>
			</div>
		</article>
	)}

	<section class="recent">
		<h2 class="kicker">Recent articles</h2>
		<div class="recent__grid">
			{recent.map((article) => (
				<article>
					<p class="kicker kicker--accent">{tagLabels(article.data.tags)}</p>
					<h3>
						<a href={`/articles/${article.id}/`}>{article.data.title}</a>
					</h3>
					<p>{article.data.description}</p>
					<p class="meta">
						<time datetime={isoDate(article.data.pubDate)}>{formatDate(article.data.pubDate)}</time>
					</p>
				</article>
			))}
			{fillers.map((placeholder) => (
				<article class="placeholder">
					<p class="kicker">Placeholder</p>
					<h3>{placeholder.title}</h3>
					<p>{placeholder.description}</p>
					<p class="meta">Not yet written</p>
				</article>
			))}
		</div>
	</section>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		align-items: baseline;
		justify-content: center;
		padding: 1.25rem 0;
		border-bottom: 1px solid var(--rule);
		text-align: center;
	}

	.featured {
		display: grid;
		grid-template-columns: 3fr 2fr;
		gap: 2rem;
		padding: 2rem 0;
		border-bottom: 1px solid var(--ink);
	}

	.featured__cover {
		display: block;
		width: 100%;
		height: auto;
	}

	.featured__text {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		justify-content: center;
	}

	.featured h1 {
		font-size: clamp(1.75rem, 3.5vw, 2.6rem);
	}

	.featured__description {
		font-size: 1.15rem;
		color: var(--muted);
	}

	.recent {
		padding: 1.5rem 0 2rem;
	}

	.recent__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		margin-top: 1rem;
	}

	.recent article {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding-inline: 1.5rem;
	}

	.recent article:first-child {
		padding-left: 0;
	}

	.recent article:last-child {
		padding-right: 0;
	}

	.recent article + article {
		border-left: 1px solid var(--rule);
	}

	.recent h3 {
		font-size: 1.3rem;
	}

	/* Muted and unlinked, so placeholders read as stand-ins rather than articles to follow. */
	.placeholder {
		color: var(--muted);
	}

	@media (width <= 48rem) {
		.featured,
		.recent__grid {
			grid-template-columns: 1fr;
		}

		.recent article,
		.recent article:first-child,
		.recent article:last-child {
			padding: 1rem 0;
		}

		.recent article + article {
			border-left: 0;
			border-top: 1px solid var(--rule);
		}
	}
</style>
