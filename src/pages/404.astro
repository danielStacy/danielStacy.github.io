---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page doesn’t exist, or it has moved.">
	<section class="not-found">
		<p class="kicker">Error 404</p>
		<h1>Page not found</h1>
		<p class="not-found__text">This page doesn’t exist, or it has moved.</p>
		<a class="meta" href="/">
			Return to the home page →
		</a>
	</section>
</BaseLayout>

<style>
	.not-found {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		align-items: center;
		padding: 4rem 0 5rem;
		text-align: center;
	}

	h1 {
		font-size: clamp(2rem, 5vw, 2.6rem);
	}

	.not-found__text {
		font-size: 1.15rem;
		color: var(--muted);
	}
</style>
