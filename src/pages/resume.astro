---
import PageLayout from '../layouts/PageLayout.astro';

// Placeholder details: replace before launch.
const experience = [
	{
		role: 'Data Analyst',
		organisation: 'Organisation name',
		dates: '2024 – present',
		points: [
			'Lorem ipsum dolor sit amet, consectetur adipiscing elit.',
			'Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.',
		],
	},
	{
		role: 'Graduate Analyst',
		organisation: 'Organisation name',
		dates: '2022 – 2024',
		points: [
			'Ut enim ad minim veniam, quis nostrud exercitation ullamco.',
			'Duis aute irure dolor in reprehenderit in voluptate velit esse.',
		],
	},
];

const education = [
	{
		qualification: 'Bachelor of Computer Science',
		institution: 'University name',
		dates: '2018 – 2021',
	},
];

const skills = ['Python', 'pandas', 'SQL', 'Tableau', 'Parquet', 'JavaScript', 'TypeScript'];

// titleLabel: the accented name makes screen readers say the noun, not the verb "resume".
---

<PageLayout
	title="Resume"
	titleLabel="Résumé"
	description="Experience, education and skills of Daniel Stacy, data analyst."
	intro="Data analyst with a computer science background."
>
	<div class="resume">
		<section>
			<h2 class="kicker">Experience</h2>
			{experience.map((job) => (
				<article class="entry">
					<h3>{job.role}</h3>
					<p class="meta">
						{job.organisation} · {job.dates}
					</p>
					<ul>
						{job.points.map((point) => (
							<li>{point}</li>
						))}
					</ul>
				</article>
			))}
		</section>

		<section>
			<h2 class="kicker">Education</h2>
			{education.map((item) => (
				<article class="entry">
					<h3>{item.qualification}</h3>
					<p class="meta">
						{item.institution} · {item.dates}
					</p>
				</article>
			))}
		</section>

		<section>
			<h2 class="kicker">Skills</h2>
			<p class="skills">{skills.join(' · ')}</p>
		</section>
	</div>
</PageLayout>

<style>
	.resume {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		max-width: var(--measure);
		margin-inline: auto;
	}

	h2 {
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--ink);
	}

	.entry {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding-block: 1.25rem;
		border-bottom: 1px solid var(--rule);
	}

	h3 {
		font-size: 1.3rem;
	}

	ul {
		margin: 0.5rem 0 0;
		padding-inline-start: 1.25em;
		font-size: 1.05rem;
	}

	li + li {
		margin-top: 0.3em;
	}

	.skills {
		padding-top: 1.25rem;
		font-size: 1.05rem;
	}
</style>
