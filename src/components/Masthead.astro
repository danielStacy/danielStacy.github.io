---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
	{ href: '/articles/', label: 'Articles' },
	{ href: '/projects/', label: 'Projects' },
	{ href: '/about/', label: 'About' },
	// The accented accessible name makes screen readers say the noun, not the verb "resume".
	{ href: '/resume/', label: 'Resume', ariaLabel: 'Résumé' },
	{ href: '/contact/', label: 'Contact' },
];
---

<header class="masthead">
	<div class="masthead__utility">
		<ThemeToggle />
	</div>
	<p class="wordmark">
		<a href="/">
			<span class="wordmark__ink">Daniel Stacy</span>
		</a>
	</p>
	<p class="tagline">Data analysis on public Australian datasets</p>
	<nav aria-label="Main">
		<ul>
			{navItems.map((item) => (
				<li>
					<a href={item.href} aria-label={item.ariaLabel}>
						{item.label}
					</a>
				</li>
			))}
		</ul>
	</nav>
</header>

<style>
	.masthead {
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 0.75rem var(--gutter) 0;
		text-align: center;
	}

	/* Reserves the toggle's height even while it is hidden, so showing it doesn't shift the page. */
	.masthead__utility {
		display: flex;
		justify-content: flex-end;
		min-height: 1.5rem;
	}

	.wordmark {
		margin-top: 0.5rem;
		font-family: 'Playfair Display', var(--serif);
		font-size: clamp(2.75rem, 10vw, 7rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1;
	}

	/*
	 * Ink colour and grain, painted as a background and clipped to the text. On an inner span so the
	 * link's focus outline is unaffected.
	 */
	.wordmark__ink {
		color: transparent;
		background-color: var(--ink);
		background-image: var(--ink-grain);
		-webkit-background-clip: text;
		background-clip: text;
	}

	@media (forced-colors: active), (prefers-contrast: more), print {
		.wordmark__ink {
			color: var(--ink);
			background: none;
		}
	}

	.tagline {
		margin-top: 0.5rem;
		font-style: italic;
		color: var(--muted);
	}

	nav {
		margin-top: 1.5rem;
		border-top: 1px solid var(--ink);
		border-bottom: 3px double var(--ink);
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
		justify-content: center;
		margin: 0;
		padding: 0.3rem 0;
		list-style: none;
		font-family: var(--sans);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	/* Padding on the link, not the list, so the whole area is tappable. */
	nav a {
		display: block;
		padding: 0.4rem 0;
	}

	/* Touch screens treat a tap as a hover, which would leave the underline stuck after tapping. */
	@media (hover: none) {
		nav a:hover {
			text-decoration: none;
		}
	}

	/*
	 * The five links don't fit on one line on a phone, so split them 3 + 2 rather than wherever the
	 * browser wraps. Six columns let the second row sit centred under the first.
	 */
	@media (width < 36rem) {
		ul {
			display: grid;
			grid-template-columns: repeat(6, 1fr);
			gap: 0.5rem 0;
			padding: 0.5rem 0;
		}

		li {
			grid-column: span 2;
		}

		li:nth-child(4) {
			grid-column: 2 / span 2;
		}

		li:nth-child(1),
		li:nth-child(2),
		li:nth-child(4) {
			border-inline-end: 1px solid var(--rule);
		}

		/*
		 * Replaces the browser's untinted tap highlight with a shade that follows the theme and feathers
		 * towards the cell's edges. It's a pseudo-element so the mask fades the shade, not the link text.
		 */
		nav a {
			position: relative;
			isolation: isolate;
			-webkit-tap-highlight-color: transparent;
		}

		nav a::before {
			position: absolute;
			inset: 0;
			z-index: -1;
			content: '';
			background-color: var(--rule);
			/*
			 * Each gradient feathers one axis; intersecting them softens all four edges. Fixed widths keep
			 * the feather narrow, so the shade stays rectangular rather than shrinking to an oval.
			 */
			mask-image:
				linear-gradient(
					to right,
					transparent,
					#000 0.75rem,
					#000 calc(100% - 0.75rem),
					transparent
				),
				linear-gradient(
					to bottom,
					transparent,
					#000 0.375rem,
					#000 calc(100% - 0.375rem),
					transparent
				);
			mask-composite: intersect;
			opacity: 0;
		}

		nav a:active::before {
			opacity: 1;
		}

		/* The shade appears instantly, so the press registers, and fades out on release. */
		@media (prefers-reduced-motion: no-preference) {
			nav a::before {
				transition: opacity 150ms ease-out;
			}

			nav a:active::before {
				transition-duration: 0s;
			}
		}
	}
</style>
