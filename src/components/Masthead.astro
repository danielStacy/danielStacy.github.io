---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
	{ href: '/articles/', label: 'Articles' },
	{ href: '/projects/', label: 'Projects' },
	{ href: '/about/', label: 'About' },
	// The accented accessible name makes screen readers say the noun, not the verb "resume".
	{ href: '/resume/', label: 'Resume', ariaLabel: 'Résumé' },
	{ href: '/contact/', label: 'Contact' },
];

// Dev and preview servers may serve a page without its trailing slash.
const currentPath = Astro.url.pathname.replace(/\/?$/, '/');

// 'page' marks the page itself; 'true' marks the section a page is in, such as an article in Articles.
function ariaCurrent(href: string) {
	if (currentPath === href) return 'page';
	if (currentPath.startsWith(href)) return 'true';
	return undefined;
}
---

<header class="masthead">
	<div class="masthead__utility">
		<ThemeToggle />
	</div>
	<p class="wordmark">
		<a href="/">
			<span class="wordmark__ink">Daniel Stacy</span>
		</a>
	</p>
	<p class="tagline">Data analysis on public Australian datasets</p>
	<nav aria-label="Main">
		<ul>
			{navItems.map((item) => (
				<li>
					<a href={item.href} aria-label={item.ariaLabel} aria-current={ariaCurrent(item.href)}>
						{item.label}
					</a>
				</li>
			))}
		</ul>
		{/* Phones only: completes the nav's second row, so the toggle needs no row of its own. */}
		<div class="nav__toggle">
			<ThemeToggle stretch />
		</div>
	</nav>
</header>

<style>
	.masthead {
		max-width: var(--page-width);
		margin: 0 auto;
		padding: 0.75rem var(--gutter) 0;
		text-align: center;
	}

	/* Reserves the toggle's height even while it is hidden, so showing it doesn't shift the page. */
	.masthead__utility {
		display: flex;
		justify-content: flex-end;
		min-height: 1.5rem;
	}

	.nav__toggle {
		display: none;
	}

	.wordmark {
		margin-top: 0.5rem;
		font-family: 'Playfair Display', var(--serif);
		font-size: clamp(2.75rem, 10vw, 7rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1;
	}

	/*
	 * Ink colour and grain, painted as a background and clipped to the text. On an inner span so the
	 * link's focus outline is unaffected.
	 */
	.wordmark__ink {
		color: transparent;
		background-color: var(--ink);
		background-image: var(--ink-grain);
		-webkit-background-clip: text;
		background-clip: text;
	}

	@media (forced-colors: active), (prefers-contrast: more), print {
		.wordmark__ink {
			color: var(--ink);
			background: none;
		}
	}

	.wordmark a {
		position: relative;
	}

	/* Replaced by the line below, which grows from where the pointer enters. */
	.wordmark a:hover {
		text-decoration: none;
	}

	/*
	 * The hover and keyboard-focus underline, in the wordmark's grained ink. It scales from
	 * --underline-origin, which the script sets to where the pointer enters or leaves; without the
	 * script it grows from the centre.
	 */
	.wordmark a::after {
		position: absolute;
		inset-inline: 0;
		/* Just under the baseline. Playfair's tall descent would otherwise put it on the tagline. */
		top: calc(100% - 0.15em);
		height: 2px;
		content: '';
		background-color: var(--ink);
		background-image: var(--ink-grain);
		opacity: 0;
		transform: scaleX(0);
		transform-origin: var(--underline-origin, 50%) center;
	}

	/* Plain ink, as for the wordmark itself. A border, because forced-colours modes drop backgrounds. */
	@media (forced-colors: active), (prefers-contrast: more), print {
		.wordmark a::after {
			height: 0;
			background: none;
			border-top: 2px solid var(--ink);
		}
	}

	/* Only where hovering is real; touch screens report a tap as a hover, which would leave it stuck. */
	@media (hover: hover) {
		.wordmark a:hover::after {
			opacity: 1;
			transform: scaleX(1);
		}
	}

	.wordmark a:focus-visible::after {
		opacity: 1;
		transform: scaleX(1);
	}

	/*
	 * Grows and fades in over 150ms after a short delay, so a pointer passing on its way to the nav
	 * doesn't set it off, then shrinks and fades out over 150ms. Keyboard focus and reduced motion show
	 * it at once.
	 */
	@media (prefers-reduced-motion: no-preference) {
		.wordmark a::after {
			transition-property: transform, opacity;
			transition-duration: 150ms;
			transition-timing-function: ease-in;
		}
	}

	@media (prefers-reduced-motion: no-preference) and (hover: hover) {
		.wordmark a:hover::after {
			transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
			transition-delay: 60ms;
		}
	}

	/* After the hover rule, so the line appears at once for keyboard focus even under the pointer. */
	.wordmark a:focus-visible::after {
		transition: none;
	}

	.tagline {
		margin-top: 0.5rem;
		font-style: italic;
		color: var(--muted);
	}

	nav {
		margin-top: 1.5rem;
		border-top: 1px solid var(--ink);
		border-bottom: 3px double var(--ink);
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
		justify-content: center;
		margin: 0;
		padding: 0.3rem 0;
		list-style: none;
		font-family: var(--sans);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	/* Padding on the link, not the list, so the whole area is tappable. */
	/* The offset applies to both the hover underline and the current-page marker, so they line up. */
	nav a {
		display: block;
		padding: 0.4rem 0;
		text-underline-offset: 0.4em;
	}

	/* Touch screens treat a tap as a hover, which would leave the underline stuck after tapping. */
	@media (hover: none) {
		nav a:hover {
			text-decoration: none;
		}
	}

	/* After the hover rule, so a tap doesn't remove the marker on touch screens. */
	nav a[aria-current] {
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-decoration-thickness: 2px;
	}

	/*
	 * The five links don't fit on one line on a phone, so lay them out 3 + 2 rather than wherever the
	 * browser wraps. The theme toggle fills the sixth cell.
	 */
	@media (width < 36rem) {
		ul {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 0.5rem 0;
			padding: 0.5rem 0;
		}

		/* Rules between cells; the third ends the first row. */
		li:not(:nth-child(3)) {
			border-inline-end: 1px solid var(--rule);
		}

		/* The toggle moves into the nav, so its row above the wordmark goes. */
		.masthead__utility {
			display: none;
		}

		/*
		 * The toggle isn't a link, so it sits outside the list. The list and the toggle share one grid
		 * cell, and the toggle is placed over the list's empty last cell: one column wide, the height
		 * of a link (2rem), and lifted by the list's bottom padding.
		 */
		nav {
			display: grid;
		}

		ul,
		.nav__toggle {
			grid-area: 1 / 1;
		}

		.nav__toggle {
			display: block;
			align-self: end;
			justify-self: end;
			width: calc(100% / 3);
			height: 2rem;
			margin-block-end: 0.5rem;
		}

		/*
		 * Replaces the browser's untinted tap highlight with a shade that follows the theme and feathers
		 * towards the cell's edges. It's a pseudo-element so the mask fades the shade, not the link text.
		 */
		nav a {
			position: relative;
			isolation: isolate;
			-webkit-tap-highlight-color: transparent;
		}

		nav a::before {
			position: absolute;
			inset: 0;
			z-index: -1;
			content: '';
			background-color: var(--rule);
			/*
			 * Each gradient feathers one axis; intersecting them softens all four edges. Fixed widths keep
			 * the feather narrow, so the shade stays rectangular rather than shrinking to an oval.
			 */
			mask-image:
				linear-gradient(
					to right,
					transparent,
					#000 0.75rem,
					#000 calc(100% - 0.75rem),
					transparent
				),
				linear-gradient(
					to bottom,
					transparent,
					#000 0.375rem,
					#000 calc(100% - 0.375rem),
					transparent
				);
			mask-composite: intersect;
			opacity: 0;
		}

		nav a:active::before {
			opacity: 1;
		}

		/* The shade appears instantly, so the press registers, and fades out on release. */
		@media (prefers-reduced-motion: no-preference) {
			nav a::before {
				transition: opacity 150ms ease-out;
			}

			nav a:active::before {
				transition-duration: 0s;
			}
		}
	}
</style>

<script>
	// Grows the wordmark's underline from where the pointer enters, and shrinks it to where it leaves.
	const wordmarkLink = document.querySelector<HTMLAnchorElement>('.wordmark a');

	function setOrigin(event: PointerEvent) {
		if (!wordmarkLink) return;
		const box = wordmarkLink.getBoundingClientRect();
		const fraction = Math.min(Math.max((event.clientX - box.left) / box.width, 0), 1);
		wordmarkLink.style.setProperty('--underline-origin', `${fraction * 100}%`);
	}

	wordmarkLink?.addEventListener('pointerenter', setOrigin);
	wordmarkLink?.addEventListener('pointerleave', setOrigin);
</script>
