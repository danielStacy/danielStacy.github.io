---
interface Props {
	/** Fills its container, with the content centred, so it can sit in a grid cell. */
	stretch?: boolean;
}

const { stretch = false } = Astro.props;
---

{/* Hidden until the script runs: without JavaScript the site follows the system setting. */}
<button class:list={['theme-toggle', { 'theme-toggle--stretch': stretch }]} type="button" hidden>
	<svg class="theme-toggle__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
		<circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
		<path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor"></path>
	</svg>
	<span class="theme-toggle__label">Dark mode</span>
</button>

<script>
	type Theme = 'light' | 'dark';

	// The masthead can render more than one toggle (one per layout), so keep them all in step.
	const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');
	const root = document.documentElement;
	const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

	const systemTheme = (): Theme => (systemDark.matches ? 'dark' : 'light');
	const currentTheme = (): Theme => (root.dataset.theme as Theme | undefined) ?? systemTheme();

	function saveTheme(theme: Theme | null) {
		try {
			if (theme) localStorage.setItem('theme', theme);
			else localStorage.removeItem('theme');
		} catch {
			// Storage can be blocked; the choice then lasts until the page is left.
		}
	}

	// A changing label with aria-pressed would contradict itself ("Light mode, pressed" in dark mode),
	// so the label alone tells everyone what the button does.
	function syncButtons() {
		const theme = currentTheme();
		buttons.forEach((button) => {
			button.dataset.current = theme;
			const label = button.querySelector('.theme-toggle__label');
			if (label) label.textContent = theme === 'dark' ? 'Light mode' : 'Dark mode';
		});
	}

	function applyTheme(theme: Theme) {
		// Choosing what the system already uses clears the override, so later system changes apply.
		if (theme === systemTheme()) {
			delete root.dataset.theme;
			saveTheme(null);
		} else {
			root.dataset.theme = theme;
			saveTheme(theme);
		}
		syncButtons();
	}

	function toggleTheme() {
		const next: Theme = currentTheme() === 'dark' ? 'light' : 'dark';
		// Cross-fade where supported. Grain images can't be colour-transitioned, but snapshots can.
		if ('startViewTransition' in document && !reduceMotion.matches) {
			document.startViewTransition(() => applyTheme(next));
		} else {
			applyTheme(next);
		}
	}

	buttons.forEach((button) => {
		button.hidden = false;
		button.addEventListener('click', toggleTheme);
	});
	syncButtons();
	systemDark.addEventListener('change', syncButtons);
</script>

<style>
	.theme-toggle {
		display: inline-flex;
		gap: 0.4rem;
		align-items: center;
		min-height: 1.5rem;
		padding: 0 0.25rem;
		border: 0;
		background: none;
		color: var(--muted);
		font-family: var(--sans);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		white-space: nowrap;
		cursor: pointer;
		/* The icon's turn is the tap feedback, so the browser's grey box isn't needed. */
		-webkit-tap-highlight-color: transparent;
	}

	/* A size container, so the icon can give way when the cell is narrow (see below). */
	.theme-toggle--stretch {
		container-type: inline-size;
		justify-content: center;
		width: 100%;
		height: 100%;
		padding: 0;
	}

	/* The display rule above would otherwise override the hidden attribute. */
	.theme-toggle[hidden] {
		display: none;
	}

	/* Only where hovering is possible; touch screens would leave the colour stuck after a tap. */
	@media (hover: hover) {
		.theme-toggle:hover {
			color: var(--ink);
		}
	}

	.theme-toggle__icon {
		flex-shrink: 0;
		width: 0.9rem;
		height: 0.9rem;
	}

	/*
	 * In a narrow nav cell, such as a 320px screen with a scrollbar or with larger text, drop the icon
	 * rather than wrap or clip the label. The label alone names the control and what it does.
	 */
	@container (width < 6rem) {
		.theme-toggle__icon {
			display: none;
		}
	}

	/* Flip the filled half to show the state; a little motion, only for those who haven't opted out. */
	[data-current='dark'] .theme-toggle__icon {
		transform: rotate(180deg);
	}

	@media (prefers-reduced-motion: no-preference) {
		.theme-toggle__icon {
			transition: transform 300ms ease;
		}
	}

	/* The theme cross-fade: the browser's default view transition, shortened from 250 ms. */
	:global(::view-transition-old(root)),
	:global(::view-transition-new(root)) {
		animation-duration: 200ms;
	}
</style>
